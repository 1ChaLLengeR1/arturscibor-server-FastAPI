# Python
__pycache__/
*.py[cod]
*.pyo
.Python
*.egg-info/

# Virtual environments
.venv/
venv/

# Environment / secrets
env/*.env
!env/example-local.env
.env

# Testing
.pytest_cache/
.coverage
htmlcov/

# Ansible (real inventory has the real server IP/user; secrets.yml is only
# ever committed encrypted, plaintext must never be — but that's a runtime
# state ansible-vault enforces, not something gitignore can catch)
infra/ansible/inventory.ini

# Uploads (docs/6-file-storage-section.md) — keep the directories, not their
# contents; ALLOWED_DIRECTORIES subfolders are recreated by main.py at startup.
static/files/*/*
!static/files/*/.gitkeep

# IDE
.idea/

# OS
.DS_Store
