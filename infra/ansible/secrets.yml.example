# Copy to infra/ansible/secrets.yml, fill in real values, then encrypt it
# in place:
#   ANSIBLE_PASSWORD=... make vault_encrypt
#
# NEVER commit an unencrypted infra/ansible/secrets.yml. The encrypted file
# IS meant to be committed (ansible-vault ciphertext is safe in git).

github_pat: ""            # GitHub PAT with repo read access, used to clone over HTTPS during deploy
doppler_token: ""         # Doppler service token, scoped to this project's "prod" config
docker_hub_username: ""
docker_hub_password: ""   # Docker Hub access token (not your account password)
