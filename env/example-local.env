# Copy this file to env/local.env and fill in real values for local development.
# env/local.env is gitignored — never commit real secrets.
# All variables are prefixed with ARTURSCIBOR_BACKEND_ (see config/settings.py).

ARTURSCIBOR_BACKEND_DB_HOST=
ARTURSCIBOR_BACKEND_DB_PORT=5432
ARTURSCIBOR_BACKEND_DB_USER=
ARTURSCIBOR_BACKEND_DB_PASSWORD=
ARTURSCIBOR_BACKEND_DB_NAME=

ARTURSCIBOR_BACKEND_SECRET_ADMIN_TOKEN=
ARTURSCIBOR_BACKEND_REFRESH_ADMIN_TOKEN=
ARTURSCIBOR_BACKEND_ACCESS_TOKEN_EXPIRE_HOURS=1
ARTURSCIBOR_BACKEND_REFRESH_TOKEN_EXPIRE_HOURS=720
ARTURSCIBOR_BACKEND_ALGORITHM=HS256
ARTURSCIBOR_BACKEND_SERVER=http://localhost:8000
ARTURSCIBOR_BACKEND_FRONTEND_URL=https://arturscibor.pl
